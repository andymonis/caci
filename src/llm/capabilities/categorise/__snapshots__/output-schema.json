{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ops": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "upsertNode"
              },
              "partition": {
                "type": "string",
                "const": "item"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "A short title for the note."
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "description": "One line saying what the note is about."
                  }
                },
                "required": [
                  "title",
                  "summary"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "op",
              "partition",
              "id",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "upsertNode"
              },
              "partition": {
                "type": "string",
                "const": "category"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "description": "A short readable name for the category."
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "op",
              "partition",
              "id",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "link"
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number"
              }
            },
            "required": [
              "op",
              "item",
              "category"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 25
    },
    "rationale": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "ops"
  ],
  "additionalProperties": false
}
