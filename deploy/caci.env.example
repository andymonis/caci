# CaCi settings on the Pi. The install script copies this to /etc/caci/caci.env (owner root, group caci, mode 0640)
# ONLY if that file does not exist. Edit the copy, never this example, and never put the real key in the repository.
# systemd reads it: one KEY=VALUE per line, no "export", no spaces around "=".

# Where the service listens: all addresses, so phones on the home Wi-Fi can reach it.
CACI_PORT=8080
CACI_BIND=0.0.0.0

# Plain HTTP on a trusted home network (R-010). Session cookies are not marked Secure and cross the Wi-Fi in clear.
CACI_ALLOW_INSECURE=true
CACI_COOKIE_SECURE=false
CACI_TRUSTED_PROXIES=0

# The exact names and addresses the family types into a browser, each with its port. Any other Host is refused.
# CHANGE THESE to your Pi's name and its fixed address.
CACI_ALLOWED_HOSTS=pi.local:8080,192.168.1.50:8080

# Away from home with Tailscale (runbook step 13): to also reach it over your private tailnet, replace the line above with this
# one, with the Pi's own tailnet name (see `tailscale status`) and the port, then run: sudo systemctl restart caci
# Nothing else changes: the service keeps listening as above and the home names keep working. Never use Tailscale Funnel.
# CACI_ALLOWED_HOSTS=pi.local:8080,192.168.1.50:8080,pi.your-tailnet.ts.net:8080

# Open until the family has accounts (the first account becomes the administrator: register yourself first),
# then set to false and restart.
CACI_ALLOW_REGISTRATION=true

# Where the databases live (the service unit gives it write access to this folder only).
CACI_DATA_DIR=/var/lib/caci

# The real model. EVERY account's notes and the names of its categories go to Anthropic, unanonymised.
# The service refuses to start until the key is set.
CACI_LLM=anthropic
ANTHROPIC_API_KEY=

# Off by default. true lets people make personal access keys for their own agent (read only, over /mcp, see the README).
# What an agent reads is sent to that agent's provider. npm run doctor shows a warning while it is on.
# CACI_AGENT_ACCESS=false

# Off by default. true lets owners and managers make join links for a circle (member or observer only, one use and approval by default, see the README).
# A link is a secret passed in a chat: anyone who holds it can ask to join. npm run doctor shows a warning while it is on.
# CACI_JOIN_LINKS=false

# How long model-usage records are kept (1 to 3650 days, default 400). They hold no text. npm run usage reports what the calls cost.
# CACI_USAGE_DAYS=400

# Optional limits (defaults shown):
# CACI_PROPOSALS_PER_HOUR=30
# CACI_MAX_PENDING_PER_USER=10
# CACI_MAX_CIRCLES_PER_USER=20
# CACI_MAX_MEMBERS_PER_CIRCLE=50
# CACI_INVITATION_DAYS=7
# CACI_MAX_BRAIN_SCOPES=25
