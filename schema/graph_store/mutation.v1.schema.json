{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "mutation"
    },
    "graphId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "createIfMissing": {
      "default": false,
      "type": "boolean"
    },
    "ops": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "upsertNode"
              },
              "partition": {
                "type": "string",
                "enum": [
                  "item",
                  "category"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "mode": {
                "default": "replace",
                "type": "string",
                "enum": [
                  "replace",
                  "merge"
                ]
              }
            },
            "required": [
              "op",
              "partition",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "deleteNode"
              },
              "partition": {
                "type": "string",
                "enum": [
                  "item",
                  "category"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "partition",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "link"
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "ensureNodes": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "op",
              "item",
              "category"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "unlink"
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "item",
              "category"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "kind",
    "graphId",
    "ops"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://github.com/andymonis/caci/schema/graph_store/mutation.v1.schema.json",
  "title": "Bipartite Graph Store mutation (v1)"
}
