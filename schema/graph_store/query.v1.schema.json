      "type": "number",
      "const": 1
    },
    "graphId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "from": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "partition": {
              "type": "string",
              "enum": [
                "item",
                "category"
              ]
            },
            "ids": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "partition",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "partition": {
              "type": "string",
              "enum": [
                "item",
                "category"
              ]
            },
            "where": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^data(\\.[A-Za-z0-9_-]+)+$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "eq": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "eq"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "ne": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "ne"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "in": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    },
                    "required": [
                      "in"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "contains": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "contains"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "startsWith": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "startsWith"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "exists": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "exists"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "partition",
            "where"
          ],
          "additionalProperties": false
        }
      ]
    },
    "traverse": {
      "default": {
        "depth": 1
      },
      "type": "object",
      "properties": {
        "depth": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "properties": {
        "partition": {
          "type": "string",
          "enum": [
            "item",
            "category"
          ]
        },
        "where": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^data(\\.[A-Za-z0-9_-]+)+$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "eq": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "eq"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "ne": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "ne"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": [
                  "in"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "contains": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "contains"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "startsWith": {
                    "type": "string"
                  }
                },
                "required": [
                  "startsWith"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "exists": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "exists"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeSeeds": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "return": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "subgraph",
            "nodes",
            "ids",
            "count"
          ]
        },
        "includeData": {
          "type": "boolean"
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false
    },
    "page": {
      "default": {
        "limit": 50,
        "cursor": null
      },
      "type": "object",
      "properties": {
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "graphId",
    "from",
    "return"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://github.com/andymonis/caci/schema/graph_store/query.v1.schema.json",
  "title": "Bipartite Graph Store query (v1)"
}
